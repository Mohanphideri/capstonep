# --- Required ---
MONGODB_URI=
AUTH_SECRET=
MSG91_AUTH_KEY=
ADMIN_PHONE=
ADMIN_PASSWORD=

# --- Optional ---
FRONTEND_URL=http://localhost:5173
PORT=4000
NODE_ENV=development

# Email (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Kuwarji Travels
SUPERADMIN_EMAIL=
WHATSAPP_NUMBER=

# File storage: LOCAL (default) or CLOUDINARY
STORAGE_PROVIDER=LOCAL
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Trip Planner — free Groq API key (no credit card required).
# Get one at https://console.groq.com/keys
# Leave blank to use the built-in rule-based trip planner instead.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
