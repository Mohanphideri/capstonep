# --- Required ---
MONGODB_URI=
AUTH_SECRET=
MSG91_AUTH_KEY=
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# --- Optional ---
FRONTEND_URL=http://localhost:5173
PORT=4000
NODE_ENV=development

# Email (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Kuwarji Travels
SUPERADMIN_EMAIL=
WHATSAPP_NUMBER=

# File storage: CLOUDINARY in production; LOCAL is for development/persistent-disk deployments
STORAGE_PROVIDER=CLOUDINARY
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Trip Planner — free Groq API key (no credit card required).
# Get one at https://console.groq.com/keys
# Leave blank to use the built-in rule-based trip planner instead.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Production deployment ---
# Exact browser origin(s), comma separated if required. Do not use * with cookies.
# FRONTEND_URL=https://www.example.com
# Public HTTPS URL of this API, used for absolute upload links.
# BACKEND_PUBLIC_URL=https://api.example.com
# Use durable object storage in production; local disk is ephemeral on most hosts.
# STORAGE_PROVIDER=CLOUDINARY
