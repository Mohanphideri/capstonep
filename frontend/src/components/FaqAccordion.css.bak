.faq {
  display: flex;
  align-items: flex-start;
  gap: 2rem;
}

/* Dark category sidebar, matching the site's ink/navy tone with a teal
   accent underline on the active tab. */
.faq-sidebar {
  display: flex;
  flex-direction: column;
  flex: 0 0 232px;
  gap: 0.15rem;
  padding: 0.9rem 0;
  border-radius: var(--radius-lg);
  background: var(--color-ink);
  position: sticky;
  top: 96px;
}

.faq-tab {
  position: relative;
  display: block;
  width: 100%;
  padding: 0.95rem 1.6rem;
  border: none;
  background: transparent;
  text-align: left;
  font-family: var(--font-display);
  font-size: 0.94rem;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.62);
  cursor: pointer;
  transition: color 0.2s ease;
}

.faq-tab:hover {
  color: rgba(255, 255, 255, 0.92);
}

.faq-tab-active {
  color: #fff;
}

.faq-tab-active::after {
  content: "";
  position: absolute;
  left: 1.6rem;
  bottom: 0.5rem;
  width: 2.1rem;
  height: 3px;
  border-radius: 999px;
  background: var(--color-marigold);
}

/* Right-hand panel: each question is its own soft-shadow card rather than
   a flat divided list. */
.faq-panel {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.faq-item {
  border: 1px solid var(--color-paper-line);
  border-radius: var(--radius-md);
  background: var(--color-paper-raised);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  transition: box-shadow 0.2s ease, border-color 0.2s ease;
}

.faq-item-open {
  border-color: var(--color-marigold-light);
  box-shadow: var(--shadow-md);
}

.faq-question {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 1.15rem 1.4rem;
  background: transparent;
  border: none;
  text-align: left;
  cursor: pointer;
}

.faq-question-text {
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 600;
  color: var(--color-ink);
}

.faq-icon {
  display: flex;
  height: 1.75rem;
  width: 1.75rem;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  border: 1px solid var(--color-paper-line);
  color: var(--color-ink);
  transition: transform 0.3s ease, background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
}

.faq-icon-open {
  transform: rotate(45deg);
  background: var(--color-marigold);
  border-color: var(--color-marigold);
  color: #fff;
}

.faq-answer-wrap {
  display: grid;
  grid-template-rows: 0fr;
  overflow: hidden;
  opacity: 0;
  transition: grid-template-rows 0.3s ease-out, opacity 0.3s ease-out, padding-bottom 0.3s ease-out;
}

.faq-answer-open {
  grid-template-rows: 1fr;
  opacity: 1;
  padding-bottom: 1.15rem;
}

.faq-answer-inner {
  min-height: 0;
}

.faq-answer {
  max-width: 42rem;
  padding: 0 1.4rem;
  font-size: 0.875rem;
  line-height: 1.6;
  color: var(--color-ink-soft);
  margin: 0;
}

@media (max-width: 760px) {
  .faq {
    flex-direction: column;
    gap: 1rem;
  }

  .faq-sidebar {
    position: static;
    flex-direction: row;
    flex: 0 0 auto;
    width: 100%;
    overflow-x: auto;
    padding: 0.6rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .faq-sidebar::-webkit-scrollbar {
    display: none;
  }

  .faq-tab {
    flex: 0 0 auto;
    white-space: nowrap;
    padding: 0.65rem 1rem;
  }

  .faq-tab-active::after {
    left: 1rem;
    bottom: 0.28rem;
  }

  .faq-panel {
    width: 100%;
  }
}
